{
  "name": "siyuan-vscodelite-edit",
  "version": "0.0.0",
  "description": "siyuan theme vscode lite edit",
  "main": "theme.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build:scss": "sass --load-path=src theme.scss:theme.css src:sub",
    "build:ts": "rollup -c",
    "build": "npm-run-all -l -p build:scss build:ts",
    "watch:scss": "sass --watch --load-path=src theme.scss:theme.css src:sub",
    "watch:ts": "rollup -c -w",
    "watch": "npm-run-all -l -p watch:scss watch:ts",
    "clean:scss": "rimraf theme.css theme.css.map sub",
    "clean:ts": "rimraf theme.js",
    "clean": "npm-run-all -l -p clean:scss clean:ts",
    "changelog": "conventional-changelog -i whatschange.md -s -n conventional-changelog.config.json -k theme.json -c theme.json && prettier -w whatschange.md"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/emptylight370/siyuan-vscodelite-edit.git"
  },
  "author": "EmptyLight",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/emptylight370/siyuan-vscodelite-edit/issues"
  },
  "homepage": "https://github.com/emptylight370/siyuan-vscodelite-edit#readme",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.0.9",
    "lefthook": "^2.0.15",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.0",
    "prettier-plugin-toml": "^2.0.6",
    "rimraf": "^6.1.2",
    "rollup": "^4.55.1",
    "sass": "^1.97.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
