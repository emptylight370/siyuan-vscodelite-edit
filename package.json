{
  "name": "siyuan-vscodelite-edit",
  "version": "0.0.0",
  "description": "siyuan theme vscode lite edit",
  "main": "theme.js",
  "packageManager": "npm@11.5.2",
  "volta": {
    "node": "22.19.0",
    "npm": "10.9.3"
  },
  "scripts": {
    "build:scss": "sass --load-path=src theme.scss:theme.css src:sub",
    "build:ts": "rollup -c",
    "build": "npm-run-all build:scss && npm run build:ts",
    "watch:scss": "sass --watch --load-path=src theme.scss:theme.css src:sub",
    "watch:ts": "rollup -c -w",
    "watch": "npm-run-all --parallel watch:scss && npm run watch:ts",
    "clean:scss": "rimraf theme.css theme.css.map sub",
    "clean:ts": "rimraf theme.js ts theme.d.ts",
    "clean": "npm-run-all clean:scss && npm run clean:ts"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/emptylight370/siyuan-vscodelite-edit.git"
  },
  "author": "EmptyLight",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/emptylight370/siyuan-vscodelite-edit/issues"
  },
  "homepage": "https://github.com/emptylight370/siyuan-vscodelite-edit#readme",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.50.1",
    "sass": "^1.92.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  }
}
