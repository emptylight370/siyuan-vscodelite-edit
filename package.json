{
  "name": "siyuan-vscodelite-edit",
  "version": "0.0.0",
  "description": "siyuan theme vscode lite edit",
  "main": "theme.js",
  "scripts": {
    "build:scss": "sass theme.scss:theme.css src/scss:sub",
    "build:ts": "esbuild src/ts/theme.ts --bundle --format=iife --outfile=theme.js --minify",
    "build": "run-p -l build:scss build:ts",
    "dev:scss": "sass --watch theme.scss:theme.css src/scss:sub",
    "dev:ts": "esbuild src/ts/theme.ts --bundle --format=iife --outfile=theme.js --watch",
    "dev": "run-p -l dev:scss dev:ts",
    "clean:scss": "rimraf theme.css theme.css.map sub",
    "clean:ts": "rimraf theme.js",
    "clean": "run-p -l clean:scss clean:ts"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/emptylight370/siyuan-vscodelite-edit.git"
  },
  "author": "EmptyLight",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/emptylight370/siyuan-vscodelite-edit/issues"
  },
  "homepage": "https://github.com/emptylight370/siyuan-vscodelite-edit#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@types/node": "^24.12.4",
    "esbuild": "^0.28.0",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "siyuan": "^1.2.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
