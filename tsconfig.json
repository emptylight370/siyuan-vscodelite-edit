{
  "compilerOptions": {
    "target": "ES5",
    "module": "ESNext",
    "declaration": false,
    "outDir": "./",
    "rootDir": "./src",
    "lib": ["ES2015", "ES2020", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
