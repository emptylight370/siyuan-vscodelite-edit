// 最低支持 WebView 95 https://github.com/siyuan-note/siyuan/issues/15147
{
  "compilerOptions": {
    // 目标环境
    "target": "es2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    // 模块系统
    "module": "ESNext",
    "moduleResolution": "bundler",
    // 类型检查
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    // 模块解析
    "esModuleInterop": true,
    // 性能优化
    "skipLibCheck": true,
    // 输出配置
    "outDir": "./",
    "rootDir": "./src/ts",
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
