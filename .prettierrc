{
  "tabWidth": 2,
  "printWidth": 120,
  "bracketSameLine": true,
  "overrides": [
    {
      "files": ["*.scss", "*.css", "*.ts", "*.js", "*.cjs"],
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": ["theme.json"],
      "options": {
        "printWidth": 20
      }
    },
    {
      "files": ["*.toml"],
      "options": {
        "parser": "toml",
        "plugins": ["prettier-plugin-toml"]
      }
    }
  ]
}
